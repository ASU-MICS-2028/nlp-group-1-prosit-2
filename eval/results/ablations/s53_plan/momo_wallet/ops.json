{
  "open_wallet": {
    "method": "POST",
    "path": "/wallets",
    "response_fields": {
      "id": "wallet_number"
    },
    "saves_key": {
      "as": "wallet",
      "field": "phone"
    }
  },
  "get_wallet": {
    "method": "GET",
    "path": "/wallets/{id}",
    "response_fields": {
      "id": "wallet_number"
    }
  },
  "deposit": {
    "method": "POST",
    "path": "/wallets/{id}/deposits"
  },
  "transfer": {
    "method": "POST",
    "path": "/wallets/{from_wallet_id}/transfers",
    "request_fields": {
      "to_wallet_id": "to_phone"
    },
    "uses_key": {
      "to_wallet_id": "wallet"
    }
  },
  "list_transactions": {
    "method": "GET",
    "path": "/wallets/{id}/history"
  }
}
