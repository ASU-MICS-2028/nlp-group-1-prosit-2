{
  "create_room": {
    "method": "POST",
    "path": "/rooms"
  },
  "book_bed": {
    "method": "POST",
    "path": "/rooms/{id}/bookings",
    "request_fields": {
      "check_in": "arrival",
      "check_out": "departure"
    },
    "response_fields": {
      "check_in": "arrival",
      "check_out": "departure"
    }
  },
  "cancel_booking": {
    "method": "DELETE",
    "path": "/bookings/{id}"
  },
  "free_beds": {
    "method": "GET",
    "path": "/availability",
    "request_fields": {
      "check_in": "arrival",
      "check_out": "departure"
    }
  }
}
