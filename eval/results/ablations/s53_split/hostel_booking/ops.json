{
  "create_room": {
    "method": "POST",
    "path": "/rooms",
    "response_fields": {
      "id": "room_number"
    }
  },
  "book_bed": {
    "method": "POST",
    "path": "/rooms/{id}/bookings",
    "request_fields": {
      "check_in": "arrival",
      "check_out": "leaving"
    },
    "response_fields": {
      "id": "booking_number",
      "check_in": "arrival",
      "check_out": "leaving",
      "room_id": "room_number"
    }
  },
  "cancel_booking": {
    "method": "DELETE",
    "path": "/bookings/{id}"
  },
  "free_beds": {
    "method": "GET",
    "path": "/availability",
    "request_fields": {
      "check_in": "arrival",
      "check_out": "leaving"
    },
    "response_fields": {
      "room_id": "room_number"
    },
    "response_key": "rooms"
  }
}
