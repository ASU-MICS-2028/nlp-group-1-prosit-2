{
  "create_table": {
    "method": "POST",
    "path": "/tables",
    "request_fields": {
      "number": "table_number"
    },
    "response_fields": {
      "number": "table_number",
      "id": "table_number"
    },
    "saves_key": {
      "as": "table",
      "field": "number"
    },
    "uses_key": {
      "id": "table"
    }
  },
  "list_tables": {
    "method": "GET",
    "path": "/tables",
    "response_fields": {
      "number": "table_number",
      "id": "table_number"
    }
  },
  "make_reservation": {
    "method": "POST",
    "path": "/reservations",
    "request_fields": {
      "id": "table_number",
      "name": "customer_name"
    },
    "response_fields": {
      "name": "customer_name"
    },
    "uses_key": {
      "id": "table"
    }
  },
  "list_reservations": {
    "method": "GET",
    "path": "/reservations",
    "response_fields": {
      "name": "customer_name"
    }
  }
}
