{
  "create_route": {
    "method": "POST",
    "path": "/routes",
    "request_fields": {
      "from_stop": "first_stop",
      "to_stop": "second_stop"
    },
    "response_fields": {
      "from_stop": "first_stop",
      "to_stop": "second_stop"
    }
  },
  "list_routes": {
    "method": "GET",
    "path": "/routes",
    "response_fields": {
      "from_stop": "first_stop",
      "to_stop": "second_stop"
    }
  },
  "find_fare": {
    "method": "GET",
    "path": "/fare",
    "request_fields": {
      "from_stop": "from",
      "to_stop": "to"
    },
    "response_fields": {
      "from_stop": "from",
      "to_stop": "to",
      "id": "route_id"
    }
  },
  "update_fare": {
    "method": "PATCH",
    "path": "/routes/{id}",
    "response_fields": {
      "from_stop": "first_stop",
      "to_stop": "second_stop"
    }
  }
}
