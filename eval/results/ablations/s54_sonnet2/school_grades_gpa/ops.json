{
  "create_student": {
    "method": "POST",
    "path": "/students"
  },
  "create_course": {
    "method": "POST",
    "path": "/courses",
    "request_fields": {
      "credits": "credit_hours"
    },
    "response_fields": {
      "credits": "credit_hours"
    }
  },
  "record_score": {
    "method": "PUT",
    "path": "/students/{id}/results/{course_id}",
    "response_fields": {
      "grade_point": "grade_points"
    }
  },
  "get_results": {
    "method": "GET",
    "path": "/students/{id}/results",
    "response_fields": {
      "courses": "results",
      "grade_point": "grade_points"
    }
  }
}
