{
  "add_team": {
    "method": "POST",
    "path": "/teams"
  },
  "list_teams": {
    "method": "GET",
    "path": "/teams"
  },
  "create_fixture": {
    "method": "POST",
    "path": "/fixtures",
    "response_fields": {
      "home_goals": "home_score",
      "away_goals": "away_score"
    }
  },
  "get_fixture": {
    "method": "GET",
    "path": "/fixtures/{id}",
    "response_fields": {
      "home_goals": "home_score",
      "away_goals": "away_score"
    }
  },
  "record_score": {
    "method": "PUT",
    "path": "/fixtures/{id}/score",
    "request_fields": {
      "home_goals": "home_score",
      "away_goals": "away_score"
    },
    "response_fields": {
      "home_goals": "home_score",
      "away_goals": "away_score"
    }
  },
  "team_fixtures": {
    "method": "GET",
    "path": "/teams/{id}/fixtures",
    "response_fields": {
      "home_goals": "home_score",
      "away_goals": "away_score"
    }
  }
}
