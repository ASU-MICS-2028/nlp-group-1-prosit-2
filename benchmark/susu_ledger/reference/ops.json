  "list_payouts": {"method": "GET", "path": "/susu-groups/{id}/collections", "fields": {"member_id": "member", "round": "round_no", "amount": "cedis"}},
  "get_statement": {"method": "GET", "path": "/susu-groups/{id}/people/{member_id}/statement", "fields": {"member_id": "member", "name": "full_name", "total_contributed": "paid_in", "total_received": "collected"}}
