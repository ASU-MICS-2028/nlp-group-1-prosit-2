  "record_score": {"method": "PUT", "path": "/league/matches/{id}/result", "fields": {"home_team_id": "host", "away_team_id": "visitor", "date": "kickoff_date", "home_goals": "host_score", "away_goals": "visitor_score"}},
  "team_fixtures": {"method": "GET", "path": "/league/clubs/{id}/matches", "fields": {"home_team_id": "host", "away_team_id": "visitor", "date": "kickoff_date", "home_goals": "host_score", "away_goals": "visitor_score"}}
